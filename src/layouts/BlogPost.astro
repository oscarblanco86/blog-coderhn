---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import EngineeringSummary from '../components/EngineeringSummary.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR, PILLARS } from '../consts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	data: Post['data'];
	minutes: number;
}

const { data, minutes } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, pillar, tags, draft } = data;
const p = PILLARS[pillar];
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
	<article>
		<header class="head">
			<div class="meta mono">
				<a href={`/pilares/${pillar}`}>{p.icon} {p.label}</a>
				<span>·</span>
				<FormattedDate date={pubDate} />
				<span>·</span>
				<span>{minutes} min</span>
				{draft && <span class="draft">BORRADOR</span>}
			</div>
			<h1>{title}</h1>
			<p class="lead">{description}</p>
			{
				updatedDate && (
					<p class="updated mono">
						actualizado: <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>

		{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}

		<EngineeringSummary data={data} />

		<div class="prose">
			<slot />
		</div>

		<footer class="post-foot">
			{
				tags.length > 0 && (
					<div class="tags">
						{tags.map((t) => (
							<span class="tag">#{t}</span>
						))}
					</div>
				)
			}
			<p class="muted">
				Escrito por <a href="/about">{AUTHOR.name}</a>. ¿Comentarios o propuestas? Escríbeme vía
				<a href={AUTHOR.github} target="_blank" rel="noopener">GitHub</a>.
			</p>
			<a class="mono back" href="/blog">← cd ../blog</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.head {
		margin-bottom: 2em;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		font-size: 0.75em;
		color: var(--text-muted);
		margin-bottom: 1em;
	}
	.meta a {
		color: var(--accent);
		text-decoration: none;
	}
	.draft {
		color: var(--warn);
	}
	.lead {
		font-size: 1.12em;
		color: var(--text-muted);
	}
	.updated {
		font-size: 0.75em;
		color: var(--text-muted);
	}
	.hero {
		width: 100%;
		margin-bottom: 2em;
	}
	.prose :global(h2) {
		padding-top: 0.3em;
		border-top: 1px solid var(--border);
	}
	.post-foot {
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid var(--border);
		font-size: 0.9em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-bottom: 1em;
	}
	.back {
		font-size: 0.85em;
		text-decoration: none;
	}
</style>
