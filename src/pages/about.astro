---
import { AUTHOR, PILLARS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description={`${AUTHOR.name} — ${AUTHOR.role}`}>
	<p class="mono muted">$ whoami</p>
	<h1>{AUTHOR.name}</h1>
	<p class="lead">{AUTHOR.role}</p>

	<!-- TODO: reescribe este texto con tu voz. -->
	<p>
		Soy ingeniero de software orientado a backend, con foco en rendimiento frontend y una formación poco
		común en el sector: <strong>gestión de calidad formal (ISO 9000)</strong>. Me interesa construir
		sistemas que funcionen en producción bajo restricciones reales — de presupuesto, de infraestructura y
		de tiempo — y documentar las decisiones que hay detrás.
	</p>
	<p>
		Este blog no es de tutoriales de sintaxis. Cada artículo es un caso de estudio: el problema, las
		restricciones, la arquitectura propuesta, el código clave y lo que medí al final.
	</p>

	<h2>Sobre qué escribo</h2>
	<ul>
		{
			Object.entries(PILLARS).map(([k, p]) => (
				<li>
					<a href={`/pilares/${k}`}>
						{p.icon} {p.label}
					</a>{' '}
					— <span class="muted">{p.description}</span>
				</li>
			))
		}
	</ul>

	<h2>Stack habitual</h2>
	<p class="stack">
		{
			['Python', 'Django', 'PostgreSQL', 'Supabase', 'Docker', 'Traefik', 'Linux', 'TypeScript', 'React', 'Vue 3', 'Astro', 'Tailwind CSS'].map(
				(s) => <span class="tag">{s}</span>,
			)
		}
	</p>

	<h2>Contacto</h2>
	<ul class="mono contact">
		<li>github → <a href={AUTHOR.github} target="_blank" rel="noopener">{AUTHOR.githubUser}</a></li>
		{AUTHOR.linkedin && <li>linkedin → <a href={AUTHOR.linkedin} target="_blank" rel="noopener">perfil</a></li>}
		{AUTHOR.email && <li>email → <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></li>}
		{AUTHOR.portfolio && <li>web → <a href={AUTHOR.portfolio} target="_blank" rel="noopener">{AUTHOR.portfolio.replace('https://', '')}</a></li>}
	</ul>
</BaseLayout>

<style>
	.lead {
		color: var(--text-muted);
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.contact {
		list-style: none;
		padding: 0;
		font-size: 0.85em;
	}
</style>
