---
import { AUTHOR } from '../consts';
import { localizePath, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const year = new Date().getFullYear();
const links = [
	{ label: 'github', href: AUTHOR.github },
	{ label: 'linkedin', href: AUTHOR.linkedin },
	{ label: 'portfolio', href: AUTHOR.portfolio },
	{ label: 'email', href: AUTHOR.email ? `mailto:${AUTHOR.email}` : '' },
	{ label: 'rss', href: localizePath('/rss.xml', Astro.props.lang) },
].filter((l) => l.href);
---

<footer>
	<div class="inner mono">
		<span>© {year} {AUTHOR.name}</span>
		<nav>
			{
				links.map((l) => (
					<a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		margin-top: 4em;
		color: var(--text-muted);
		font-size: 0.8em;
	}
	.inner {
		max-width: 1000px;
		margin: auto;
		padding: 2em 16px 3em;
		display: flex;
		flex-wrap: wrap;
		gap: 1em;
		justify-content: space-between;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2em;
	}
	a {
		color: var(--text-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
</style>
