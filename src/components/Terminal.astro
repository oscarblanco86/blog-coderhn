---
/**
 * Terminal interactiva sin dependencias: explora y filtra los artículos.
 * El índice de posts se serializa en build y el script (vanilla TS) lo consume en el cliente.
 */
import { AUTHOR, PILLARS } from '../consts';
import { localizePath, type Lang } from '../i18n/ui';
import { getPosts, postUrl } from '../lib/posts';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;

// Textos de la terminal por idioma. {x} se reemplaza en el cliente.
const STRINGS = {
	es: {
		aria: 'Terminal interactiva',
		inputAria: 'Escribe un comando',
		welcome: 'Bienvenido. Escribe <span class="acc">help</span> para ver comandos, o prueba <span class="acc">ls</span>.',
		noResults: 'Sin resultados.',
		help: 'muestra esta ayuda',
		ls: 'ls [pilar] — lista artículos',
		lsUnknown: 'ls: pilar desconocido "{x}". Prueba <span class="acc">pilares</span>',
		pillars: 'muestra los pilares de contenido',
		grep: 'grep <texto> — busca en títulos, tags y descripciones',
		grepUsage: 'uso: grep <texto>',
		open: 'open <n|slug> — abre un artículo',
		openNotFound: 'open: no encontrado "{x}"',
		opening: 'abriendo {x}…',
		whoami: 'quién escribe este blog',
		clear: 'limpia la pantalla',
		notFound: '{x}: comando no encontrado. Escribe <span class="acc">help</span>',
	},
	en: {
		aria: 'Interactive terminal',
		inputAria: 'Type a command',
		welcome: 'Welcome. Type <span class="acc">help</span> to list commands, or try <span class="acc">ls</span>.',
		noResults: 'No results.',
		help: 'show this help',
		ls: 'ls [pillar] — list articles',
		lsUnknown: 'ls: unknown pillar "{x}". Try <span class="acc">pillars</span>',
		pillars: 'show the content pillars',
		grep: 'grep <text> — search titles, tags and descriptions',
		grepUsage: 'usage: grep <text>',
		open: 'open <n|slug> — open an article',
		openNotFound: 'open: not found "{x}"',
		opening: 'opening {x}…',
		whoami: 'who writes this blog',
		clear: 'clear the screen',
		notFound: '{x}: command not found. Type <span class="acc">help</span>',
	},
} satisfies Record<Lang, Record<string, string>>;
const strings = STRINGS[lang];

const posts = (await getPosts(lang)).map((p) => ({
	slug: p.id.split('/').slice(1).join('/'),
	url: postUrl(p),
	title: p.data.title,
	pillar: p.data.pillar,
	tags: p.data.tags,
	description: p.data.description,
}));

const index = {
	posts,
	pillars: Object.fromEntries(Object.entries(PILLARS).map(([k, v]) => [k, v.label[lang]])),
	pillarsCmd: lang === 'es' ? 'pilares' : 'pillars',
	base: localizePath('/', lang),
	s: strings,
	author: { name: AUTHOR.name, role: AUTHOR.role, location: AUTHOR.location, github: AUTHOR.github },
};
---

<section class="term" aria-label={strings.aria}>
	<div class="bar mono">
		<span class="dots"><i></i><i></i><i></i></span>
		<span>visitor@coderhn: ~/blog</span>
	</div>
	<div class="out mono" id="term-out" aria-live="polite"></div>
	<form class="line mono" id="term-form" autocomplete="off">
		<label for="term-in" class="ps1">$</label>
		<input id="term-in" type="text" spellcheck="false" aria-label={strings.inputAria} placeholder="help" />
	</form>
</section>

<script type="application/json" id="term-data" set:html={JSON.stringify(index)} />

<script>
	type Item = { slug: string; url: string; title: string; pillar: string; tags: string[]; description: string };
	type Index = {
		posts: Item[];
		pillars: Record<string, string>;
		pillarsCmd: string;
		base: string;
		s: Record<string, string>;
		author: { name: string; role: string; location: string; github: string };
	};

	const data: Index = JSON.parse(document.getElementById('term-data')!.textContent || '{}');
	const out = document.getElementById('term-out')!;
	const form = document.getElementById('term-form') as HTMLFormElement;
	const input = document.getElementById('term-in') as HTMLInputElement;
	const history: string[] = [];
	let hIdx = 0;
	const s = data.s;
	const fmt = (tpl: string, x: string) => tpl.replace('{x}', x);
	const base = data.base; // "/" o "/en/"

	const esc = (s: string) =>
		s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

	function print(html: string, cls = '') {
		const div = document.createElement('div');
		if (cls) div.className = cls;
		div.innerHTML = html;
		out.appendChild(div);
		out.scrollTop = out.scrollHeight;
	}

	function list(items: Item[]) {
		if (!items.length) return print(s.noResults, 'dim');
		items.forEach((p, i) =>
			print(
				`<span class="dim">[${i + 1}]</span> <span class="acc">${esc(p.pillar)}/</span><a href="${esc(p.url)}">${esc(p.title)}</a>`,
			),
		);
	}

	const commands: Record<string, { help: string; run: (args: string[]) => void }> = {
		help: {
			help: s.help,
			run: () =>
				Object.entries(commands).forEach(([name, c]) =>
					print(`<span class="acc">${name.padEnd(9)}</span> <span class="dim">${c.help}</span>`),
				),
		},
		ls: {
			help: s.ls,
			run: ([pillar]) => {
				if (pillar && !data.pillars[pillar]) return print(fmt(s.lsUnknown, esc(pillar)), 'err');
				list(pillar ? data.posts.filter((p) => p.pillar === pillar) : data.posts);
			},
		},
		[data.pillarsCmd]: {
			help: s.pillars,
			run: () =>
				Object.entries(data.pillars).forEach(([k, label]) => {
					const n = data.posts.filter((p) => p.pillar === k).length;
					print(`<a href="${base}pilares/${k}">${k}</a> <span class="dim">— ${esc(label)} (${n})</span>`);
				}),
		},
		grep: {
			help: esc(s.grep),
			run: (args) => {
				const q = args.join(' ').toLowerCase();
				if (!q) return print(esc(s.grepUsage), 'err');
				list(
					data.posts.filter((p) =>
						[p.title, p.description, ...p.tags].join(' ').toLowerCase().includes(q),
					),
				);
			},
		},
		open: {
			help: esc(s.open),
			run: ([arg]) => {
				const n = Number(arg);
				const post = Number.isInteger(n) && n > 0 ? data.posts[n - 1] : data.posts.find((p) => p.slug === arg);
				if (!post) return print(fmt(s.openNotFound, esc(arg ?? '')), 'err');
				print(fmt(s.opening, esc(post.slug)), 'dim');
				location.href = post.url;
			},
		},
		whoami: {
			help: s.whoami,
			run: () => {
				print(`<span class="acc">${esc(data.author.name)}</span> — ${esc(data.author.location)}`);
				print(esc(data.author.role), 'dim');
				print(`<a href="${esc(data.author.github)}" target="_blank" rel="noopener">${esc(data.author.github)}</a> · <a href="${base}about">/about</a>`);
			},
		},
		clear: { help: s.clear, run: () => (out.innerHTML = '') },
	};
	const aliases: Record<string, string> = { cat: 'open', cd: 'ls', find: 'grep', '?': 'help', pilares: data.pillarsCmd, pillars: data.pillarsCmd };

	function exec(raw: string) {
		const line = raw.trim();
		print(`<span class="acc">$</span> ${esc(line)}`, 'cmd');
		if (!line) return;
		history.push(line);
		hIdx = history.length;
		const [name, ...args] = line.split(/\s+/);
		const cmd = commands[aliases[name] ?? name];
		cmd ? cmd.run(args) : print(fmt(s.notFound, esc(name)), 'err');
	}

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		exec(input.value);
		input.value = '';
	});

	input.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowUp' && hIdx > 0) {
			input.value = history[--hIdx];
			e.preventDefault();
		} else if (e.key === 'ArrowDown') {
			hIdx = Math.min(history.length, hIdx + 1);
			input.value = history[hIdx] ?? '';
			e.preventDefault();
		} else if (e.key === 'Tab') {
			const match = Object.keys(commands).find((c) => c.startsWith(input.value) && input.value);
			if (match) {
				input.value = match + ' ';
				e.preventDefault();
			}
		}
	});

	out.closest('.term')!.addEventListener('click', (e) => {
		if (!(e.target as HTMLElement).closest('a')) input.focus({ preventScroll: true });
	});

	print(s.welcome, 'dim');
</script>

<style>
	.term {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--code-bg);
		color: #c9d1d9;
		overflow: hidden;
		font-size: 0.8em;
		box-shadow: 0 12px 40px rgb(0 0 0 / 25%);
		--acc: #3fb950;
		--dim: #7d8590;
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 1em;
		padding: 0.55em 0.9em;
		background: #161b22;
		color: var(--dim);
		font-size: 0.85em;
		border-bottom: 1px solid #21262d;
	}
	.dots {
		display: flex;
		gap: 6px;
	}
	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #30363d;
	}
	.dots i:first-child {
		background: #f85149;
	}
	.dots i:nth-child(2) {
		background: #d29922;
	}
	.dots i:nth-child(3) {
		background: #3fb950;
	}
	.out {
		height: 220px;
		overflow-y: auto;
		padding: 0.9em 1em 0;
		line-height: 1.6;
		white-space: pre-wrap;
	}
	.line {
		display: flex;
		gap: 0.6em;
		padding: 0.3em 1em 0.9em;
	}
	.ps1 {
		color: var(--acc);
	}
	input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: none;
		outline: none;
		color: inherit;
		font: inherit;
		caret-color: var(--acc);
	}
	input::placeholder {
		color: #484f58;
	}
	.out :global(a) {
		color: #58a6ff;
	}
	.out :global(.acc) {
		color: var(--acc);
	}
	.out :global(.dim) {
		color: var(--dim);
	}
	.out :global(.err) {
		color: #f85149;
	}
	.out :global(.cmd) {
		margin-top: 0.4em;
	}
</style>
