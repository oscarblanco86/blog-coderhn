---
/**
 * Botón de tema: auto → claro → oscuro → auto…
 * El estado vive en <html data-theme> (lo fija antes del primer pintado el script de BaseHead)
 * y se guarda en localStorage("theme"). Sin data-theme = automático (sigue al sistema).
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const t = useTranslations(Astro.props.lang);
const labels = { label: t('theme.label'), auto: t('theme.auto'), light: t('theme.light'), dark: t('theme.dark') };
---

<button class="theme-toggle" type="button" data-labels={JSON.stringify(labels)} aria-label={`${labels.label}: ${labels.auto}`} title={`${labels.label}: ${labels.auto}`}>
	<!-- auto: medio círculo -->
	<svg class="i-auto" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
		<path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
	</svg>
	<!-- claro: sol -->
	<svg class="i-light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
		<g stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
		</g>
	</svg>
	<!-- oscuro: luna -->
	<svg class="i-dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
		<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"></path>
	</svg>
</button>

<script>
	type Mode = 'auto' | 'light' | 'dark';
	const order: Mode[] = ['auto', 'light', 'dark'];
	const root = document.documentElement;

	const current = (): Mode => (root.dataset.theme as Mode) || 'auto';

	function apply(mode: Mode, btn: HTMLElement) {
		if (mode === 'auto') delete root.dataset.theme;
		else root.dataset.theme = mode;
		try {
			if (mode === 'auto') localStorage.removeItem('theme');
			else localStorage.setItem('theme', mode);
		} catch {}
		const l = JSON.parse(btn.dataset.labels || '{}');
		const text = `${l.label}: ${l[mode]}`;
		btn.setAttribute('aria-label', text);
		btn.title = text;
	}

	document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
		apply(current(), btn); // sincroniza etiquetas con el estado guardado
		btn.addEventListener('click', () => apply(order[(order.indexOf(current()) + 1) % order.length], btn));
	});
</script>

<style>
	.theme-toggle {
		display: flex;
		padding: 0.4em;
		background: none;
		border: none;
		border-radius: 6px;
		color: var(--text-muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--accent);
	}
	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent);
	}
	svg {
		display: none;
	}
	:global(html:not([data-theme])) .i-auto,
	:global(html[data-theme='light']) .i-light,
	:global(html[data-theme='dark']) .i-dark {
		display: block;
	}
</style>
