---
import { LANG_META, type Lang } from '../i18n/ui';

interface Props {
	date: Date;
	lang: Lang;
}

const { date, lang } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(LANG_META[lang].locale, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
</time>
